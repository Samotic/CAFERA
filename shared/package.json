{
  "name": "@cafera/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, zod contracts and domain constants for CAFERA.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.9",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
