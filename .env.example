# ==========================================================================
# CAFERA — environment template
#
#   cp .env.example .env.local
#
# Every variable here is validated by src/lib/env.ts at module load. An unset
# variable is an EMPTY STRING, not undefined, so `.min(1)` is what makes a
# missing value fail loudly with its own name instead of travelling silently
# into a URL or a signing key.
#
# CRITICAL: only `NEXT_PUBLIC_`-prefixed variables reach the browser bundle, and
# everything with that prefix is public — visible in DevTools to anyone who
# loads the site. Nothing below that prefix is a secret, and nothing secret goes
# above it. `npm run scan:secrets` enforces this against the built output.
# ==========================================================================

# --- Database ------------------------------------------------------------
# MongoDB Atlas SRV string. The database user should hold readWrite on this
# database only — never the Atlas admin user, never a cluster-wide role.
#
# Pin the cluster to the same region as the Vercel functions (Frankfurt /
# eu-central-1). A cross-region cluster adds 100ms+ per query, paid again for
# every query a page issues.
MONGODB_URI=mongodb://127.0.0.1:27017/cafera

# --- Public site ---------------------------------------------------------
# Absolute origin, required for canonical URLs, Open Graph tags and the sitemap.
# A relative canonical is silently ignored by crawlers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Authentication (Phase 3 — Better Auth) ------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The 32-character floor is enforced now rather than when the feature lands: a
# short signing secret does not fail, it quietly weakens every session it signs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Image uploads (Phase 4 — Vercel Blob) -------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Recipe photography --------------------------------------------------
# Use a server-side image search/import job to select one licensed photo per
# recipe. Never expose the provider key with NEXT_PUBLIC_ prefix.
PEXELS_API_KEY=

# Optional Cloudinary delivery. The cloud name is public; the API credentials
# are server-only and are used by the import job, not browser components.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
