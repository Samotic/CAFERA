# ==========================================================================
# CAFERA API — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed: every value below is a credential or a security control.
#
#   cp server/.env.example server/.env
# ==========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Used to build absolute links in password-reset emails.
API_PUBLIC_URL=http://localhost:4000

# --- Database ------------------------------------------------------------
# MongoDB Atlas SRV string. The database user should hold readWrite on this
# database only — never the Atlas admin user, and never a cluster-wide role.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/cafera?retryWrites=true&w=majority
# Separate database for the test suite, so `npm test` can never touch real data.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/cafera_test

# --- Authentication ------------------------------------------------------
# Generate each of these independently:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# They must differ. Reusing one secret for both token types means a leaked
# access token can be replayed as a refresh token.
JWT_ACCESS_SECRET=replace-with-64-bytes-of-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-bytes-of-hex
# Short access-token life keeps a stolen token useful for minutes, not weeks.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# bcrypt cost. 12 is the floor; raise it as hardware improves.
BCRYPT_ROUNDS=12

# --- Cookies -------------------------------------------------------------
# Leave blank for localhost. In production set the registrable domain shared by
# the frontend and the API (e.g. `.cafera.app`) so the refresh cookie is sent
# to the API from the site's own origin.
COOKIE_DOMAIN=
# `lax` for a same-site deployment; `none` when the frontend and API sit on
# different registrable domains — which additionally requires Secure=true.
COOKIE_SAMESITE=lax
# Must be true in production. A refresh cookie over plain HTTP is a free session.
COOKIE_SECURE=false

# --- CORS ----------------------------------------------------------------
# Comma-separated exact origins. Never `*`: with credentials enabled, a
# wildcard origin would let any site on the internet act as a logged-in user.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Images (Cloudinary) -------------------------------------------------
# The cloud name is public; the API secret is not and must never be sent to
# the browser. Uploads are signed server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=cafera

# --- Email (password reset) ----------------------------------------------
# Left empty in development: reset links are written to the server log instead
# of being sent, so the flow is testable without an email provider.
SMTP_URL=
MAIL_FROM="CAFERA <no-reply@cafera.app>"
# Where reset links point — the frontend, not the API.
WEB_PUBLIC_URL=http://localhost:3000

# --- Ask CAFERA (optional, feature-flagged) ------------------------------
# Off by default. The key stays server-side; the browser never sees it.
AI_FEATURE_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=512

# --- Observability -------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
